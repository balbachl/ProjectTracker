@{
    ViewData["Title"] = "Acme Project Tracker";
}
<div class="row">
    <div class="text-center col-7">
        <h1 class="display-3">Acme Project Tracker</h1>
        <p class="display-5">Welcome to the Acme Project Tracker application!</p>
        <p class="display-6">
            Building Bridges and Finding Solutions<br />
            One Project at a Time
        </p>
    </div>
    <div id="carouselcontrols" class="carousel slide align-content-center col-5 bg-light" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/team1.jpg" class="d-block w-100" alt="Business Project">
            </div>
            <div class="carousel-item">
                <img src="~/images/team2.jpg" class="d-block w-100" alt="Design Project">
            </div>
            <div class="carousel-item">
                <img src="~/images/team3.jpg" class="d-block w-100" alt="IT Project">
            </div>
            <div class="carousel-item">
                <img src="~/images/team4.jpg" class="d-block w-100" alt="Warehouse Project">
            </div>
        </div>
        <!-- Left and right controls/icons -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselcontrols" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselcontrols" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>
